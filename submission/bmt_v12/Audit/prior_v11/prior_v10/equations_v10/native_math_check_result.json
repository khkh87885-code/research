      "audited_latex": "\\begin{aligned}a_{m,i}(t)&=\\mathbf{1}\\{r_{m,i}\\ge t\\},\\\\v_{m,\\mathrm{dev}}(t)&=\\frac{1}{N_{\\mathrm{dev}}}\\sum_{i\\in\\mathrm{dev}}a_{m,i}(t).\\end{aligned}",
      "pass": true
    },
    {

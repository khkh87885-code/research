      "actual_office_math_sha256": "5f9f86709c3cde911185d3c2a16aeed79d93c9ee01933c28633b69a42bcff5ca",
      "audited_latex": "\\mathrm{CI}_{95\\%}^{\\mathrm{boot}}=[Q_{0.025}\\{\\theta^{*(b)}:b\\in\\mathcal V\\},\\ Q_{0.975}\\{\\theta^{*(b)}:b\\in\\mathcal V\\}].",

      "audited_latex": "t_m^*=\\underset{t\\in\\mathcal T_m}{\\operatorname{argmin}_{\\mathrm{lex}}}(\\lvert v_{m,\\mathrm{dev}}(t)-b\\rvert,\\ v_{m,\\mathrm{dev}}(t)).",
      "pass": true
    },
    {

      "audited_latex": "\\begin{aligned}w_s^*&=\\frac{w_{E,s}+w_{I,s}}{2},\\qquad P_c^{\\mathrm{std}}=\\sum_s w_s^*p_{c,s},\\\\P_E^{\\mathrm{std}}-P_I^{\\mathrm{std}}&=W.\\end{aligned}",
      "pass": true
    },
    {
      "document": "supplement",
      "label": "S1",
      "actual_office_math_sha256": "cbe60c1582dd030616d394f152ab5a0688fe55f6b7be588346eaab31fb9f2b6d",
      "audited_latex": "(L,U)=\\frac{\\hat p+\\frac{z^2}{2n}\\ \\pm\\ z\\sqrt{\\frac{\\hat p(1-\\hat p)}{n}+\\frac{z^2}{4n^2}}}{1+\\frac{z^2}{n}}.",

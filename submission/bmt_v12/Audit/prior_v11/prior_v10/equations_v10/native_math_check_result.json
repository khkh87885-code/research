      "audited_latex": "\\begin{aligned}\\hat f_{+,-}&=\\frac{1}{\\lvert\\mathcal V_J\\rvert}\\sum_{b\\in\\mathcal V_J}\\mathbf1\\{\\Delta_{\\mathrm{fixed}}^{*(b)}>0,\\ \\Delta_{\\mathrm{equal}}^{*(b)}<0\\},\\\\\\hat f_{-,+}&=\\frac{1}{\\lvert\\mathcal V_J\\rvert}\\sum_{b\\in\\mathcal V_J}\\mathbf1\\{\\Delta_{\\mathrm{fixed}}^{*(b)}<0,\\ \\Delta_{\\mathrm{equal}}^{*(b)}>0\\}.\\end{aligned}",

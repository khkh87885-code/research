      "audited_latex": "\\begin{aligned}B_{0,i}&=\\operatorname{clip}_{\\Omega_i}(B_i+e_i),\\\\e_i&=(-0.10w_i,-0.10h_i,0.10w_i,0.10h_i).\\end{aligned}",

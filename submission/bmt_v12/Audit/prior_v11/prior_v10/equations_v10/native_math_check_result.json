      "audited_latex": "\\begin{aligned}d_m&=\\frac{TP_m}{F},\\qquad v_m=\\frac{TP_m+FP_m}{N},\\\\M_m&=100\\frac{FN_m}{N},\\qquad F=TP_m+FN_m.\\end{aligned}",
      "pass": true
    },
    {
      "document": "main",
      "label": "10",
      "actual_office_math_sha256": "03dbe476e89463a0f396e2cc4e4a46d8965cc7f14084fd2c36a791595895fd89",
      "audited_latex": "\\begin{aligned}\\Delta_{H1}&=100(d_{A,E}-d_{A,I}),\\\\\\Delta_{H2}&=100(v_{A,E}-v_{A,I}),\\\\\\Delta_{H3}&=100(d_{B,E}-d_{A,E}).\\end{aligned}",
      "pass": true
    },
    {
      "document": "main",
      "label": "11",
      "actual_office_math_sha256": "f6bd424537d680311f516a41f7638ac2d8150d009daa4e8bf0600e6078ff1d9c",
      "audited_latex": "\\begin{aligned}K(b,N)&=\\min\\underset{k\\in\\{0,\\ldots,N\\}}{\\operatorname{argmin}}\\lvert k-bN\\rvert,\\\\a_{m,i}^{(K)}&=\\mathbf{1}\\{\\operatorname{rank}_m(i)\\le K(b,N)\\}.\\end{aligned}",

      "audited_latex": "\\begin{aligned}B_{j,i}&=\\operatorname{clip}_{\\Omega_i}\\{B_{0,i}+(u_{j,i},v_{j,i},u_{j,i},v_{j,i})\\},\\\\(u_{j,i},v_{j,i})&\\in\\{(-\\delta_{x,i},0),(\\delta_{x,i},0),(0,-\\delta_{y,i}),(0,\\delta_{y,i})\\},\\\\\\delta_{x,i}&=0.05w_{0,i},\\qquad\\delta_{y,i}=0.05h_{0,i}.\\end{aligned}",
      "pass": true
    },
    {

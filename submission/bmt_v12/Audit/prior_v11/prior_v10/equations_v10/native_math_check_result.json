      "audited_latex": "\\begin{aligned}\\mathcal R(x,y;\\rho)&=\\sqrt{\\max(x^2+y^2-2\\rho xy,0)},\\\\L_{\\Delta}&=\\hat\\Delta-\\mathcal R(\\hat p_1-L_1,U_2-\\hat p_2;\\rho),\\\\U_{\\Delta}&=\\hat\\Delta+\\mathcal R(U_1-\\hat p_1,\\hat p_2-L_2;\\rho).\\end{aligned}",
      "pass": true
    },

      "audited_latex": "\\begin{aligned}\\Delta_P=P_E-P_I&=C+W,\\\\C&=\\sum_s(w_{E,s}-w_{I,s})\\frac{p_{E,s}+p_{I,s}}{2},\\\\W&=\\sum_s(p_{E,s}-p_{I,s})\\frac{w_{E,s}+w_{I,s}}{2}.\\end{aligned}",
      "pass": true
    },

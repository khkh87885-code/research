      "audited_latex": "\\begin{aligned}\\operatorname{Specificity}_m&=\\frac{TN_m}{TN_m+FP_m},\\\\\\operatorname{PPV}_m&=\\frac{TP_m}{TP_m+FP_m},\\\\\\operatorname{NPV}_m&=\\frac{TN_m}{TN_m+FN_m}.\\end{aligned}",
      "pass": true
    },
    {
      "document": "main",
      "label": "13",
